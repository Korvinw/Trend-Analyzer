{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "rapidapi-tiktok": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "https://mcp.rapidapi.com",
        "--header",
        "x-api-host: tiktok-api23.p.rapidapi.com",
        "--header",
        "x-api-key: {env:TIKTOK_RAPIDAPI_KEY}"
      ],
      "enabled": true
    }
  }
}